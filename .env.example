# ─────────────────────────────────────────────────────────────────────────────
# GİDENLER INTELLIGENCE LAYER — ortam değişkenleri (ÖRNEK; gerçek değerleri buraya yazma)
# Gerçek anahtarlar yalnızca Vercel → Project → Settings → Environment Variables'a girilir.
# Bu dosya repoya girer; .env.local / .env.production ASLA girmez (bkz. .gitignore).
# Hiçbir AI_* / *_API_KEY değeri istemciye gitmez; yalnızca NEXT_PUBLIC_BASE_PATH istemcide görünür.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dağıtım modu ──────────────────────────────────────────────────────────────
# GitHub Pages (statik): NEXT_OUTPUT=export + NEXT_BASE_PATH=/gidenler  (workflow ayarlar; API yok)
# Vercel (sunucu): ikisini de BOŞ bırak → app/api/ai/* etkin.
NEXT_OUTPUT=
NEXT_BASE_PATH=

# ── Sağlayıcı anahtarları (yalnızca kullanılacak olan) ────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# Self-hosted / proxy / OpenAI uyumlu uç (vLLM, Ollama…): isteğe bağlı
# OPENAI_BASE_URL=http://localhost:11434/v1
# MISTRAL_BASE_URL=
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=

# ── Model rolleri (model adı koda gömülü DEĞİL; buradan değiştirilir) ─────────
# provider: anthropic | openai | gemini | mistral | none
# Model adları ÖRNEKTİR; güncel/erişilebilir adı sağlayıcının model listesinden doğrula (isim değişince kod değişmez).
AI_PRIMARY_PROVIDER=anthropic          # kullanıcıya görünen karar + gerekçe
AI_PRIMARY_MODEL=claude-sonnet-4-5
AI_FAST_PROVIDER=gemini                # niyet ayrıştırma / sınıflandırma (ucuz)
AI_FAST_MODEL=gemini-2.5-flash
AI_JUDGE_PROVIDER=openai               # örneklemeli kalite denetimi
AI_JUDGE_MODEL=gpt-4.1-mini
AI_GROUNDING_PROVIDER=none             # gemini | none  (Search grounding; henüz akışta zorunlu değil)
AI_GROUNDING_MODEL=gemini-2.5-flash

# Yedek zincir: birincil sağlayıcı düşerse sırayla denenir (yalnızca anahtarı olanlar)
AI_FALLBACK_CHAIN=gemini,openai
# Yedek sağlayıcıda kullanılacak model: AI_FALLBACK_MODEL_<ROL>_<SAĞLAYICI> ya da AI_FALLBACK_MODEL_<SAĞLAYICI>
AI_FALLBACK_MODEL_PRIMARY_GEMINI=gemini-2.5-pro
AI_FALLBACK_MODEL_PRIMARY_OPENAI=gpt-4.1

# ── Niyet modu: local (yalnızca yerel ayrıştırıcı) | hybrid (belirsizse hızlı model) | fast ──
AI_INTENT_MODE=hybrid

# ── Bütçe / maliyet (USD, aylık) ──────────────────────────────────────────────
AI_MONTHLY_BUDGET_USD=100
AI_BUDGET_WARN_RATIO=0.7      # admin uyarısı
AI_BUDGET_DEGRADE_RATIO=0.9   # judge/eval kapanır
AI_BUDGET_HARD_RATIO=1.0      # pahalı model kapanır → deterministik motor
AI_JUDGE_SAMPLE_RATE=0.1
# Fiyat tablosu geçersiz kılma (USD / 1M token, "giriş,çıkış"): AI_PRICE_<PROVIDER>_<MODEL>
# AI_PRICE_ANTHROPIC_CLAUDE_SONNET_4_5=3,15

# ── Sınırlar ──────────────────────────────────────────────────────────────────
AI_MAX_INPUT_CHARS=600
AI_MAX_TOOL_CALLS=4
AI_REQUEST_TIMEOUT_MS=25000
AI_MODEL_TIMEOUT_MS=18000
AI_RATE_LIMIT_PER_MINUTE=12
AI_RATE_LIMIT_PER_DAY=200
AI_CACHE_TTL_SEC=3600
AI_CACHE_TTL_TIME_SENSITIVE_SEC=300

# ── Gözlemlenebilirlik ────────────────────────────────────────────────────────
# Admin uç noktası (GET /api/ai/admin, "Authorization: Bearer …"). Boşsa uç nokta kapalı (404).
AI_ADMIN_TOKEN=
# Bütçe defteri dosyası (yalnızca tek sunucu / yerel; Vercel'de bellek → KV önerilir)
AI_LEDGER_FILE=
