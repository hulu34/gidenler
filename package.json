{
  "name": "gidenler",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:static": "NEXT_OUTPUT=export NEXT_BASE_PATH=/gidenler next build",
    "ai:sec": "tsx scripts/aisec.ts",
    "ai:eval": "tsx scripts/aieval.ts",
    "qa": "tsx scripts/searchqa.ts && tsx scripts/semqa.ts",
    "test:seckisi": "tsx scripts/seckisitest.ts",
    "test:arama": "tsx scripts/aramatest.ts",
    "test:seo": "tsx scripts/seotest.ts",
    "db:generate": "drizzle-kit generate && tsx scripts/db-bundle-migrations.ts",
    "test:db": "tsx scripts/dbtest.ts && NEXT_PUBLIC_SHOW_DEMO=true tsx scripts/dbtest.ts",
    "db:status": "tsx scripts/db-migrate.ts",
    "db:apply": "tsx scripts/db-migrate.ts --apply"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@upstash/redis": "^1.39.0",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "next": "^15.5.25",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "private": true
}
